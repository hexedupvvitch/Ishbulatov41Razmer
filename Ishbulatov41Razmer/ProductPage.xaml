<Page x:Class="Ishbulatov41Razmer.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Ishbulatov41Razmer"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1200"
      Title="ProductPage" FontFamily="Comic Sans MS">

    <Grid Background="#FFFFCC99">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="270"/>
        </Grid.ColumnDefinitions>

        <!-- Информация о пользователе -->
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="20,20,0,0">
            <TextBlock Text="Вы авторизованы как" FontSize="15" TextWrapping="Wrap" />
            <TextBlock x:Name="FIOTB" FontSize="15" FontWeight="Bold" Margin="0,5,0,0" />
            <TextBlock Text="Роль:" FontSize="15" Margin="0,10,0,0" />
            <TextBlock x:Name="RoleTB" FontSize="15" FontWeight="Bold" Margin="0,5,0,0" />
        </StackPanel>

        <!-- Поиск -->
        <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Margin="0,20,20,0">
            <TextBlock Text="Поиск по наименованию" FontSize="15" Margin="0,0,0,5" />
            <TextBox x:Name="TBoxSearch" TextChanged="TBoxSearch_TextChanged" Width="200" FontSize="15" Height="25"/>
        </StackPanel>

        <!-- Фильтр по скидке -->
        <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" Margin="0,20,20,0" Orientation="Vertical">
            <TextBlock Text="Фильтрация по скидке" FontSize="15" Margin="0,0,0,5" />
            <ComboBox x:Name="ComboType" SelectionChanged="ComboType_SelectionChanged" Width="200" FontSize="15" Height="25">
                <TextBlock Text="Все диапазоны"/>
                <TextBlock Text="от 0 до 9,99%"/>
                <TextBlock Text="от 10 до 14,99%"/>
                <TextBlock Text="от 15% и более"/>
            </ComboBox>
        </StackPanel>

        <!-- Сортировка -->
        <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10">
            <RadioButton Content="По возрастанию стоимости" GroupName="Sort" Width="235" FontSize="15" Checked="RButtonUp_Checked" Name="RButtonUp" />
            <RadioButton Content="По убыванию стоимости" GroupName="Sort" Width="235" FontSize="15" Checked="RButtonDown_Checked" Name="RButtonDown" />
        </StackPanel>

        <!-- Счётчик -->
        <TextBlock x:Name="Status" Grid.Row="0" Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="20,20,20,0" FontSize="15" />

        <!-- Кнопка Корзина -->
        <Button x:Name="ViewOrderBtn" 
                Content="Корзина" 
                Width="120" 
                Height="40" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Top"
                Grid.Column="2"
                Grid.Row="0"
                Margin="20,60,20,0"
                Visibility="Collapsed" 
                Click="ViewOrderBtn_Click"
                FontSize="16">
        </Button>

        <!-- Список товаров -->
        <ListView Name="ProductListView" Grid.Row="1" Grid.RowSpan="3" Grid.ColumnSpan="3" Margin="10,10,10,10"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Добавить к заказу" Click="AddToOrderMenuItem_Click"/>
                </ContextMenu>
            </ListView.ContextMenu>

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,10" Background="White">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <!-- Изображение -->
                            <Image Width="200" Grid.Column="0" Grid.RowSpan="4"  Stretch="UniformToFill" HorizontalAlignment="Center">
                                <Image.Source>
                                    <Binding Path="ProductPhotoPath">
                                        <Binding.TargetNullValue>
                                            <ImageSource>
                                                Resources/picture.png
                                            </ImageSource>
                                        </Binding.TargetNullValue>
                                    </Binding>
                                </Image.Source>
                            </Image>

                            <!-- Информация -->
                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock Text="{Binding ProductName}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ProductDescription}" FontSize="14" TextWrapping="Wrap" Foreground="#555" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding ProductManufacturer}" FontSize="14" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding ProductCost, StringFormat={}{0:N2} рублей}" FontSize="18" FontWeight="Bold" Foreground="#CC0000" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding ProductQuantityInStock, StringFormat={}В наличии: {0} шт.}" FontSize="14" Foreground="#228B22" Margin="0,5,0,0"/>
                            </StackPanel>

                            <!-- Скидка -->
                            <Border Grid.Column="2" BorderThickness="1" BorderBrush="#E0E0E0" Background="#FFF3E0" 
                        Width="80" HorizontalAlignment="Right">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="Скидка" FontSize="14" HorizontalAlignment="Center" Foreground="#E65100"/>
                                    <TextBlock Text="{Binding ProductDiscountAmount, StringFormat={}{0}%}" FontSize="24" FontWeight="Bold" 
                                   HorizontalAlignment="Center" Foreground="#E65100"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
                </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>