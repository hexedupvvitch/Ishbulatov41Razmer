<Window x:Class="Ishbulatov41Razmer.OrderWindow1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ishbulatov41Razmer"
        mc:Ignorable="d"
        Title="Оформление заказа" Height="700" Width="900"
        FontFamily="Comic Sans MS" Background="#FFFFCC99">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="300"/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Дата заказа -->
        <TextBlock Text="Дата формирования заказа:" Grid.Row="0" Grid.Column="0" 
                   VerticalAlignment="Center" FontSize="18" Margin="0,10"/>
        <DatePicker Grid.Row="0" Grid.Column="1" 
                    x:Name="DateOrder" Height="35" FontSize="16" 
                    Margin="0,10" IsEnabled="False"/>

        <!-- Дата доставки -->
        <TextBlock Text="Дата доставки:" Grid.Row="1" Grid.Column="0" 
                   VerticalAlignment="Center" FontSize="18" Margin="0,10"/>
        <DatePicker Grid.Row="1" Grid.Column="1" 
                    x:Name="DateDelivery" Height="35" FontSize="16" 
                    Margin="0,10" IsEnabled="False"/>

        <!-- ФИО клиента -->
        <TextBlock Text="ФИО клиента:" Grid.Row="2" Grid.Column="0" 
                   VerticalAlignment="Center" FontSize="18" Margin="0,10"/>
        <TextBlock x:Name="FIOTB" Grid.Row="2" Grid.Column="1" 
                   VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Margin="0,10"/>

        <!-- Номер заказа -->
        <TextBlock Text="Номер заказа:" Grid.Row="3" Grid.Column="0" 
                   VerticalAlignment="Center" FontSize="18" Margin="0,10"/>
        <TextBlock x:Name="NUMBERTB" Grid.Row="3" Grid.Column="1" 
                   VerticalAlignment="Center" FontSize="18" FontWeight="Bold" 
                   Foreground="#CC0000" Margin="0,10"/>

        <!-- Цена -->
        <TextBlock Text="Цена:" Grid.Row="4" Grid.Column="0"
           VerticalAlignment="Top"
           FontSize="18"
           Margin="0,0,0,5"/>

        <TextBlock x:Name="Cost"
           Grid.Row="4"
           Grid.Column="1"
           VerticalAlignment="Top"
           FontSize="18"
           FontWeight="Bold"
           Foreground="#CC0000"
           Margin="0,0,0,5"/>

        <!-- Скидка -->
        <TextBlock Text="Скидка:"
           Grid.Row="4"
           Grid.Column="0"
           VerticalAlignment="Bottom"
           FontSize="18"
           Margin="0,30,0,0"/>

        <TextBlock x:Name="DiscountTB"
           Grid.Row="4"
           Grid.Column="1"
           VerticalAlignment="Bottom"
           FontSize="18"
           FontWeight="Bold"
           Foreground="#FF6600"
           Margin="0,30,0,0"/>
        
        <!-- Список товаров -->
        <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" 
                BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,10" Background="White">
            <ListView x:Name="ShoeListView" Background="Transparent" 
                      ScrollViewer.VerticalScrollBarVisibility="Auto" BorderThickness="0">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="Margin" Value="0,0,0,5"/>
                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Изображение -->
                            <Image Width="200" Grid.Column="0" Grid.RowSpan="4"  Stretch="UniformToFill" HorizontalAlignment="Center">
                                <Image.Source>
                                    <Binding Path="ProductPhotoPath">
                                        <Binding.TargetNullValue>
                                            <ImageSource>
                                                Resources/picture.png
                                            </ImageSource>
                                        </Binding.TargetNullValue>
                                    </Binding>
                                </Image.Source>
                            </Image>

                            <!-- Информация о товаре -->
                            <StackPanel Grid.Column="1" Margin="15,0">
                                <TextBlock Text="{Binding ProductName}" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ProductDescription}" FontSize="14" Foreground="#555"/>
                                <TextBlock Text="{Binding ProductManufacturer}" FontSize="14"/>
                                <TextBlock Text="{Binding ProductCost, StringFormat={}Цена: {0:N2} руб.}" 
                                           FontSize="16" FontWeight="Bold" Foreground="#CC0000"/>
                                <TextBlock Text="{Binding ProductDiscountAmount, StringFormat={}Скидка: {0}%}" 
                                           FontSize="14" Foreground="#FF6600"/>
                            </StackPanel>

                            <!-- Управление количеством -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="−" Width="35" Height="35" FontSize="18"
                                            Tag="{Binding}" Click="BtnMinus_Click"/>
                                    <TextBlock Text="{Binding ProductQuantityInStock}" FontSize="20" 
                                               Width="50" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <Button Content="+" Width="35" Height="35" FontSize="18"
                                            Tag="{Binding}" Click="BtnPlus_Click"/>
                                </StackPanel>
                                <Button Content="Удалить" Width="120" Height="30" FontSize="14" 
                                        Margin="0,10,0,0" Tag="{Binding}" Click="BtnDelete_Click"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Пункт выдачи + кнопки -->
        <Grid Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Пункт выдачи:" Grid.Column="0" VerticalAlignment="Center" FontSize="16" Margin="0,0,10,0"/>
            <ComboBox x:Name="ComboPickUpPoint" Grid.Column="1" Height="30" FontSize="14" 
                      SelectionChanged="ComboPickUpPoint_SelectionChanged"
                      DisplayMemberPath="FullAddress"
                      SelectedValuePath="PickUpPointId"/>

            <Button x:Name="BtnBack" Grid.Column="2" Content="Назад" Width="120" Height="40" 
                    FontSize="16" Margin="10,0" Click="BtnBack_Click"/>
            <Button x:Name="BtnSave" Grid.Column="3" Content="Сохранить заказ" Width="150" Height="40" 
                    FontSize="16" Click="SaveBtn_Click" Background="#4CAF50" Foreground="White"/>
        </Grid>
    </Grid>
</Window>